NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://localhost:27017/campuszen
JWT_ACCESS_SECRET=change_me_access_32_chars_min
JWT_REFRESH_SECRET=change_me_refresh_32_chars_min
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_REMEMBER_EXPIRES=7d
JWT_REFRESH_DEFAULT_EXPIRES=1d
FRONTEND_URL=http://localhost:3000
COOKIE_SECURE=false
# lax when API + frontend share one origin; "none" when they live on different
# hosts (requires COOKIE_SECURE=true — browsers reject SameSite=None otherwise)
# COOKIE_SAMESITE=lax
# ── Email / OTP delivery ──────────────────────────────────────────────
# Preferred: Resend over HTTPS (works from Render/datacenter IPs).
# Create a key at https://resend.com/api-keys and verify the sending domain
# there. EMAIL_FROM must be an address on that verified domain.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# EMAIL_FROM=no-reply@yourdomain.com
# EMAIL_FROM_NAME=CampusZen
#
# Fallback: Gmail SMTP — requires an App Password, NOT your login password.
# Create one at: Google Account > Security > 2-Step Verification > App passwords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=xxxx_xxxx_xxxx_xxxx
# SMTP_FROM must be an address the SMTP account is allowed to send as
# (for Gmail, use the same address as SMTP_USER). Defaults to SMTP_USER
# when RESEND_API_KEY is also set, otherwise to EMAIL_FROM.
# SMTP_FROM=you@gmail.com
# EMAIL_FROM=you@gmail.com
# EMAIL_FROM_NAME=CampusZen
#
# Configure at least one transport: RESEND_API_KEY OR SMTP_USER + SMTP_PASS.
# The backend refuses to boot without one because OTP verification is required.
# Appwrite (server-side only — never expose to frontend)
# APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
# APPWRITE_PROJECT_ID=your_project_id
# APPWRITE_API_KEY=your_api_key_with_storage_write
# APPWRITE_BUCKET_ID=your_bucket_id
# Optional split bucket for videos (falls back to APPWRITE_BUCKET_ID).
# Useful to set different max file sizes / encryption per bucket in Appwrite.
# APPWRITE_VIDEO_BUCKET_ID=your_video_bucket_id
# Admin dashboard (/admin) — env-gated, no DB user needed.
# Set both to enable admin login. Passkey should be 32+ random chars.
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSKEY=change_me_32_chars_min_random_string
# Optional: admin session length (default 2h)
# ADMIN_TOKEN_EXPIRES=2h
# Web Push (VAPID) — OS-level notifications when app is closed.
# Generate once: npx web-push generate-vapid-keys
# Public key also goes to frontend as NEXT_PUBLIC_VAPID_PUBLIC_KEY.
# VAPID_PUBLIC_KEY
# VAPID_PRIVATE_KEY
# VAPID_SUBJECT=mailto:admin@campuszen.tech
# For production set:
# NODE_ENV=production
# COOKIE_SECURE=true
# FRONTEND_URL=https://campuszen.tech
# MONGO_URI=mongodb+srv://...
# JWT_ACCESS_SECRET=<32+ random chars, no placeholder text>
# JWT_REFRESH_SECRET=<32+ random chars, no placeholder text>
# COOKIE_SAMESITE=none  # only when frontend and API are on different hosts
